include:
  - project: 'modulosource/modulotech/devops/gitlab-ci-templates'
    file:
      - '/templates/helm.gitlab-ci.yml'
      - '/templates/integration.gitlab-ci.yml'
      - '/templates/docker-buildx.gitlab-ci.yml'

variables:
  IMAGE_NAME: <%= image_name %>

stages:
  - test
  - build
  - deploy

build_integration_image:
  extends: .build_integration_image
  variables:
    DOCKERFILE: .devcontainer/Dockerfile

test:
  extends: .test
  services:
    <%- if postgresql? -%>
    - postgres:16-alpine
    - redis:7-alpine
    <%- elsif mysql? -%>
    - mysql:8-alpine
    - redis:7-alpine
    <%- end -%>
    - redis:7-alpine
  variables:
    RAILS_ENV: test
    <%- if postgresql? -%>
    POSTGRES_DB: <%= image_name %>-test
    POSTGRES_USER: postgres
    POSTGRES_PASSWORD: postgres
    DATABASE_TEST_URL: postgresql://postgres:postgres@postgres/<%= image_name %>-test
    <%- elsif mysql? -%>
    MYSQL_DATABASE: <%= image_name %>-test
    MYSQL_ALLOW_EMPTY_PASSWORD: 'true'
    DATABASE_TEST_URL: mysql2://root@mysql/<%= image_name %>-test
    <%- end -%>
  script:
    - bin/test

seeds:
  extends: .test
  services:
    <%- if postgresql? -%>
    - postgres:16-alpine
    <%- elsif mysql? -%>
    - mysql:8-alpine
    <%- end -%>
    - redis:7-alpine
  variables:
    RAILS_ENV: test
    <%- if postgresql? -%>
    POSTGRES_DB: <%= image_name %>-seeds
    POSTGRES_USER: postgres
    POSTGRES_PASSWORD: postgres
    DATABASE_TEST_URL: postgresql://postgres:postgres@postgres/<%= image_name %>-seeds
    <%- elsif mysql? -%>
    MYSQL_DATABASE: <%= image_name %>-seeds
    MYSQL_ALLOW_EMPTY_PASSWORD: 'true'
    DATABASE_TEST_URL: mysql2://root@mysql/<%= image_name %>-seeds
    <%- end -%>
  script:
    - bin/rails db:drop db:create db:schema:load db:seed

<%- if vue? -%>
vitest:
  extends: .test
  before_script:
    - rm -rf node_modules
    - npm install
  script:
    - npm run test

<%- end -%>
rubocop:
  extends: .lint

rubocop_light:
  extends: .lint
  script:
    - rubocop --except Metrics/PerceivedComplexity,Metrics/CyclomaticComplexity,Metrics/BlockLength,Metrics/AbcSize,Metrics/MethodLength,Metrics/ParameterLists,Metrics/ModuleLength
  allow_failure: false

<%- if vue? -%>
eslint:
  extends: .lint
  before_script:
    - npm install
  script:
    - npm run lint
  allow_failure: false

<%- end -%>
bundleraudit:
  extends: .bundleraudit

brakeman:
  extends: .ruby_brakeman

docker_build:
  extends: .docker_buildx_push
  variables:
    DOCKERFILE: Dockerfile
  only:
    - merge_requests
    - staging
    - master

<%- if review_base_url && !review_base_url.to_s.empty? -%>
deploy_review:
  extends: .deploy_helm
  variables:
    NAMESPACE: <%= image_name %>-$CI_ENVIRONMENT_SLUG
    NAME: <%= image_name %>
    CHART_NAME: rails
    CONFIG_FILE: config/deploy/review.yaml
    EXTRA_VARS: --set image.tag=$CI_COMMIT_SHORT_SHA --set ingress.hosts[0].host=${CI_ENVIRONMENT_SLUG}.<%= review_base_url %> --set ingress.tls[0].hosts[0]=${CI_ENVIRONMENT_SLUG}.<%= review_base_url %> --set env.url=${CI_ENVIRONMENT_SLUG}.<%= review_base_url %> --set database.url=$DATABASE_URL --set master_key.key=$MASTER_KEY
  environment:
    name: review/$CI_COMMIT_REF_SLUG
    url: https://${CI_ENVIRONMENT_SLUG}.<%= review_base_url %>
    on_stop: stop_review
    auto_stop_in: 3 days
  only:
    - merge_requests

stop_review:
  extends: .stop_review
  variables:
    NAMESPACE: <%= image_name %>-$CI_ENVIRONMENT_SLUG
    NAME: <%= image_name %>
  only:
    - merge_requests
<%- end -%>

<%- if staging_url && !staging_url.to_s.empty? -%>
deploy_staging:
  extends: .deploy_helm
  variables:
    NAMESPACE: <%= image_name %>
    NAME: <%= image_name %>
    CHART_NAME: rails
    CONFIG_FILE: config/deploy/staging.yaml
    EXTRA_VARS: --set image.tag=$CI_COMMIT_SHORT_SHA --set database.url=$DATABASE_URL --set master_key.key=$MASTER_KEY
  environment:
    name: staging
    url: https://<%= staging_url %>
    on_stop: stop_staging
    auto_stop_in: 7 days
  only:
    - staging

stop_staging:
  extends: .stop_staging
  variables:
    NAMESPACE: <%= image_name %>
    NAME: <%= image_name %>
  only:
    - staging
  needs:
    - docker_build
<%- end -%>

<%- if production_url && !production_url.to_s.empty? -%>
deploy_production:
  extends: .deploy_helm
  variables:
    NAMESPACE: <%= image_name %>
    NAME: <%= image_name %>
    CHART_NAME: rails
    CONFIG_FILE: config/deploy/production.yaml
    EXTRA_VARS: --set image.tag=$CI_COMMIT_SHORT_SHA
  environment:
    name: production
    url: https://<%= production_url %>
  only:
    - master
<%- end -%>
