#!/usr/bin/env bash

# Script version
SCRIPT_VERSION="2.0.pre1"

# Initialize variables with default values
mode="importmap"
interpreter="mri"
version="latest"
beta_mode=false

# Helper function: Manage file operations for update
perform_update() {
    local new_version=$1
    if sudo mv "/tmp/moduloproject_new" "/usr/local/bin/moduloproject" && sudo chmod +x "/usr/local/bin/moduloproject"; then
        echo "Updated to version $new_version. Please run the script again."
        exit 0
    else
        echo "Update failed. Please try again or update manually."
        exit 1
    fi
}

# Helper function: Prompt user for confirmation
confirm_update() {
    local new_version=$1
        read -p "New version $new_version available. Update? (y/n) " -n 1 -r
        echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "Proceeding with the update..."
        perform_update "$new_version"
    else
        echo "Update canceled."
    fi
}

# Function to update the script
update_script() {
    local url=$1
    local force=$2
    echo "Checking for updates..."

    # Download the new version
    if curl -fs "$url" -o "/tmp/moduloproject_new"; then
        # Compare with the version of the downloaded script
        local new_version
        new_version=$(grep '^SCRIPT_VERSION=' "/tmp/moduloproject_new" | head -n 1 | cut -d'"' -f2)
        if [ -z "$new_version" ]; then
            echo "Failed to check for updates: no version found in the downloaded script."
        elif [ "$new_version" != "$SCRIPT_VERSION" ]; then
            if [ "$force" = true ]; then
                echo "Forcing update to version $new_version..."
                perform_update "$new_version"
            elif [ "$beta_mode" = true ]; then
                echo "Beta mode enabled."
                confirm_update "$new_version"
            else
                confirm_update "$new_version"
            fi
        else
            echo "You are already using the latest version."
        fi
    else
        echo "Failed to check for updates."
    fi
    rm -f "/tmp/moduloproject_new"
}

# Help function in English
show_help() {
  echo "Usage: moduloproject [OPTIONS]"
  echo "Options:"
  echo "  -m, --mode MODE                 Mode (importmap, esbuild, webpack). Default: importmap"
  echo "  -i, --interpreter INTERPRETER   Interpreter (mri, jruby). Default: mri"
  echo "  -r, --ruby-version RUBY_VERSION Ruby version. Default: latest"
  echo "  -b, --beta                      Enable beta mode (uses development branch)"
  echo "  -u, --update                    Force update check"
  echo "  -h, --help                      Display this help message"
  echo "  -v, --version                   Display script version"
}

# Parse options
while [ "$#" -gt 0 ]; do
  case "$1" in
    -m|--mode) mode="$2"; shift 2 ;;
    -i|--interpreter) interpreter="$2"; shift 2 ;;
    -r|--ruby-version) version="$2"; shift 2 ;;
    -b|--beta) beta_mode=true; shift ;;
    -u|--update) update_script "https://raw.githubusercontent.com/moduloTech/moduloproject/master/moduloproject" true; shift ;;
    -h|--help) show_help; exit 0 ;;
    -v|--version) echo "moduloproject version $SCRIPT_VERSION"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; show_help; exit 1 ;;
  esac
done

# Check for updates
if [ "$beta_mode" = true ]; then
    update_script "https://raw.githubusercontent.com/moduloTech/moduloproject/development/moduloproject" false
else
    update_script "https://raw.githubusercontent.com/moduloTech/moduloproject/master/moduloproject" true
fi

# Validate options
if [ "$mode" != "importmap" ] && [ "$mode" != "esbuild" ] && [ "$mode" != "webpack" ]; then
  echo "Unknown mode: $mode" >&2
  show_help
  exit 1
fi

if [ "$interpreter" != "mri" ] && [ "$interpreter" != "jruby" ]; then
  echo "Unknown interpreter: $interpreter" >&2
  show_help
  exit 1
fi

echo "Executing with mode $mode on interpreter $interpreter (version $version)"
if [ "$beta_mode" = true ]; then
  echo "Beta mode enabled: using development branch"
fi

local_project_directory=$(pwd -P)
project_name=${local_project_directory##*/}
docker_project_directory="/$project_name"
git_email=$(git config --get user.email)
git_name=$(git config --get user.name)

echo "Generating project $project_name"

# Set the template URL based on beta mode
if [ "$beta_mode" = true ]; then
  template_url="https://raw.githubusercontent.com/moduloTech/moduloproject/development/template.rb"
else
  template_url="https://raw.githubusercontent.com/moduloTech/moduloproject/master/template.rb"
fi

# shellcheck disable=SC2016
script='echo "Installing latest version of Rails" && \
    gem install rails --no-document && \
    echo "Installing latest version of Bundler" && \
    gem update --system && \
    echo "Configuring name for default branch of git" && \
    git config --global init.defaultBranch master && \
    echo "Generating new Rails application" && \
    rails new . --skip-docker --skip-test --skip-system-test --skip-rubocop --skip-ci --skip-kamal --skip-solid \
    -d postgresql -m '"$template_url"' $EXTRA_RAILS_ARGS'

# Fully qualified so that podman does not depend on short-name resolution
test "$interpreter" = "mri" && image="docker.io/library/ruby:$version"
test "$interpreter" = "jruby" && image="docker.io/library/jruby:$version"

# Pick the container engine: CONTAINER_ENGINE if set, else docker when its daemon answers, else podman
if [ -n "$CONTAINER_ENGINE" ]; then
  engine="$CONTAINER_ENGINE"
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  engine="docker"
elif command -v podman >/dev/null 2>&1; then
  engine="podman"
else
  echo "No usable container engine: start the docker daemon or install podman" >&2
  exit 1
fi
echo "Using container engine $engine"

if [ "$mode" != "importmap" ]; then
  extra_rails_args="-j $JAVASCRIPT_MODE -c sass"
else
  extra_rails_args=""
fi

# Add variables for PostgreSQL
postgres_container_name="moduloproject_postgres"
postgres_password="mysecretpassword"
# Published on the loopback so that the host-network Rails container reaches it with docker and rootless podman
# alike; not 5432, which a local PostgreSQL often holds already
postgres_port="${POSTGRES_PORT:-55432}"

echo "Starting PostgreSQL container"
$engine run --name $postgres_container_name -e POSTGRES_PASSWORD=$postgres_password \
  -p "127.0.0.1:$postgres_port:5432" -d docker.io/library/postgres:latest

# Wait for PostgreSQL to accept TCP connections (the init server only listens on the socket)
echo "Waiting for PostgreSQL to start..."
tries=0
until $engine exec $postgres_container_name pg_isready -q -h 127.0.0.1 -U postgres; do
  tries=$((tries + 1))
  if [ $tries -ge 60 ]; then
    echo "PostgreSQL did not start within 60 seconds" >&2
    break
  fi
  sleep 1
done

# Build the database URL
database_url="postgres://postgres:${postgres_password}@127.0.0.1:${postgres_port}/postgres"

# Run container command
$engine run --name moduloproject --pull=always --rm -a STDOUT -ti -w "$docker_project_directory" \
  -v "$local_project_directory":"$docker_project_directory" \
  -e "GIT_AUTHOR_EMAIL=$git_email" -e "GIT_AUTHOR_NAME=$git_name" -e "GIT_COMMITTER_EMAIL=$git_email" -e "GIT_COMMITTER_NAME=$git_name" \
  -e "JAVASCRIPT_MODE=$mode" -e "EXTRA_RAILS_ARGS=$extra_rails_args" -e "MODULORAILS_BETA_MODE=$beta_mode" \
  -e "DATABASE_URL=$database_url" \
  --network host \
  "$image" bash -c "$script"

# Cleanup: stop and remove PostgreSQL container
echo "Cleanup: stopping PostgreSQL container"
$engine stop $postgres_container_name
$engine rm $postgres_container_name
